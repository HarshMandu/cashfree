generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum ErpSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum ErpOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model PaymentOrder {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String
  erpReferenceId    String

  cashfreeOrderId   String        @unique
  paymentSessionId  String?

  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")

  status            PaymentStatus @default(INITIATED)
  erpSyncStatus     ErpSyncStatus @default(PENDING)
  lastCashfreeEventAt DateTime?

  idempotencyKey    String        @unique
  requestHash       String
  customerId        String

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  transactions      PaymentTransaction[]
  erpNotifications  ErpStatusOutbox[]
}

model PaymentTransaction {
  id                    String        @id @default(uuid()) @db.Uuid

  paymentOrderId        String        @db.Uuid
  paymentOrder          PaymentOrder  @relation(fields: [paymentOrderId], references: [id])

  cashfreePaymentId     String?       @unique

  amount                Decimal       @db.Decimal(12, 2)
  currency              String

  status                PaymentStatus

  paymentMethod         String?
  bankReference         String?
  paymentTime           DateTime?
  providerEventAt       DateTime?

  rawResponse           Json?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([paymentOrderId])
}

model WebhookEvent {
  id                  String   @id @default(uuid()) @db.Uuid

  eventId             String   @unique
  eventType           String?

  cashfreeOrderId     String?

  payload             Json

  processed            Boolean  @default(false)
  processedAt          DateTime?

  createdAt            DateTime @default(now())

  @@index([cashfreeOrderId])
}

model ErpStatusOutbox {
  id             String          @id @default(uuid()) @db.Uuid
  eventId        String          @unique
  paymentOrderId String          @db.Uuid
  paymentOrder   PaymentOrder    @relation(fields: [paymentOrderId], references: [id])
  status         PaymentStatus
  payload        Json
  state          ErpOutboxStatus @default(PENDING)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sentAt         DateTime?

  @@index([state, nextAttemptAt])
}